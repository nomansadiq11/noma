# Local compose settings
KUBE_CONTEXT=kind-noma
KUBE_NAMESPACE=default
KUBE_API_SERVER=https://host.docker.internal:6443
KUBE_SKIP_TLS_VERIFY=true

# LLM planner/summarizer settings
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=
LLM_MODEL=llama2:latest

# Optional overrides
# AGENT_URL=http://agent:8001
# DATABASE_URL=postgresql://noma:noma@postgres:5432/noma
# REDIS_URL=redis://redis:6379/0
